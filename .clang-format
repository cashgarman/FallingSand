BasedOnStyle: Microsoft
ColumnLimit: 100
IndentWidth: 4
UseTab: Never
LineEnding: CRLF
PointerAlignment: Left
AllowShortFunctionsOnASingleLine: None
AllowShortIfStatementsOnASingleLine: Never
BreakBeforeBraces: Custom
BraceWrapping:
    AfterClass: true
    AfterEnum: true
    AfterFunction: true
    AfterNamespace: false
    AfterStruct: true
    BeforeCatch: false
    BeforeElse: false

