// Decide what fraction of incoming liquid each square can accept.
// Later passes count room opened by liquid that a neighbor is already able to take away.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "world.glsl"

layout(local_size_x = 16, local_size_y = 8) in;

// Look up the previous acceptance for a neighboring square.
float previousAcceptance(ivec2 neighbor)
{
	if (!inside(neighbor))
		return 0.0;

	int cellIndex = indexOf(neighbor);
	return pc.operation.y == 0u ? limitB[cellIndex] : limitA[cellIndex];
}

// Work out available room from the four shared face transfers.
void main()
{
	ivec2 gridPos = ivec2(gl_GlobalInvocationID.xy);
	if (!inside(gridPos))
		return;

	int cellIndex = indexOf(gridPos);
	vec4 toward = incomingFaces(gridPos, cellIndex);
	float incoming = dot(max(toward, vec4(0)), vec4(1));
	float acceptance = 0.0;
	if (incoming > 0.0)
	{
		float room = max(0.0, 1.0 - volume(readCell(cellIndex)));
		if (pc.operation.x != 0u && room < incoming)
		{
			// Count only outflow already accepted in the previous pass.
			// Implementation: acceptance can only increase, so accepted inflow fits after outflow.
			vec4 accepted = vec4(previousAcceptance(gridPos - RIGHT),
			                     previousAcceptance(gridPos - DOWN),
			                     previousAcceptance(gridPos + RIGHT),
			                     previousAcceptance(gridPos + DOWN));
			room += dot(max(-toward, vec4(0)), accepted);
		}
		acceptance = min(1.0, room / incoming);
	}
	if (pc.operation.y == 0u)
		limitA[cellIndex] = acceptance;
	else
		limitB[cellIndex] = acceptance;
}
