// Move water, oil, and lava through the four faces of each square.
// Both sides of a face use the same transfer, so a blocked face cannot create or lose liquid.
#version 460
#extension GL_GOOGLE_include_directive : require
#include "world.glsl"

layout(local_size_x = 16, local_size_y = 8) in;

// Take the donor's share of each liquid in proportion to how much of it the donor holds.
vec3 received(int donorIndex, float amount)
{
	if (amount <= 0.0)
		return vec3(0);

	Cell donorCell = readCell(donorIndex);
	return donorCell.liquid * (amount / max(volume(donorCell), 1e-30));
}

// Debit accepted outflow and credit incoming liquid using the same amounts on both sides.
void main()
{
	ivec2 gridPos = ivec2(gl_GlobalInvocationID.xy);
	if (!inside(gridPos))
		return;

	int cellIndex = indexOf(gridPos);
	Cell cell = readCell(cellIndex);
	vec4 toward = incomingFaces(gridPos, cellIndex);
	if (any(notEqual(toward, vec4(0))))
	{
		// At the border the corresponding flow is zero, so a safe index can stand in for that neighbor.
		int leftIndex = gridPos.x > 0 ? cellIndex - 1 : cellIndex;
		int topIndex = gridPos.y > 0 ? cellIndex - pc.size.x : cellIndex;
		int rightIndex = gridPos.x + 1 < pc.size.x ? cellIndex + 1 : cellIndex;
		int bottomIndex = gridPos.y + 1 < pc.size.y ? cellIndex + pc.size.x : cellIndex;

		// The receiver decides the accepted share on each face. Read those decisions before moving any liquid.
		vec4 acceptedIn = max(toward, vec4(0)) * limitA[cellIndex];
		vec4 neighborAcceptance = vec4(limitA[leftIndex], limitA[topIndex],
		                               limitA[rightIndex], limitA[bottomIndex]);
		float acceptedOut = dot(max(-toward, vec4(0)), neighborAcceptance);

		// Keep the part that did not leave, then add the matching shares from our neighbors.
		float fill = volume(cell);
		if (acceptedOut > 0.0 && fill > 0.0)
			cell.liquid *= 1.0 - acceptedOut / fill;
		cell.liquid += received(leftIndex, acceptedIn.x) + received(topIndex, acceptedIn.y) +
		               received(rightIndex, acceptedIn.z) + received(bottomIndex, acceptedIn.w);
	}
	writeOther(cellIndex, cell);
}
